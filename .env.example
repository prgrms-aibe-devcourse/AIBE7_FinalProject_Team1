POSTGRES_DB=aibe7
POSTGRES_USER=aibe7
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/aibe7
DB_USERNAME=aibe7
DB_PASSWORD=change-me

# Supabase Dashboard > Connect > Session pooler (port 5432)
# Activate with SPRING_PROFILES_ACTIVE=supabase.
SUPABASE_DB_URL=jdbc:postgresql://your-session-pooler-host:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-with-your-database-password
SUPABASE_DB_MAX_POOL_SIZE=5
SUPABASE_DB_MIN_IDLE=1
SUPABASE_DB_CONNECTION_TIMEOUT_MS=30000

TEST_DB_URL=jdbc:postgresql://localhost:5432/aibe7_test
TEST_DB_USERNAME=aibe7
TEST_DB_PASSWORD=change-me
TEST_JWT_SECRET=change-this-test-jwt-secret-at-least-32-bytes

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# HS256 requires a secret of at least 32 bytes. Replace this value outside local development.
JWT_SECRET=change-this-local-jwt-secret-at-least-32-bytes
AI_API_KEY=change-me-when-ai-integration-is-added
# Required for document extraction and Gemini-backed AI features in the full release.
# AI_API_KEY remains a listing AI fallback; document extraction reads GEMINI_API_KEY directly.
GEMINI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOCAL_STORAGE_ROOT=./storage
# Production uses private user-content S3 and an EC2 IAM role; never add access keys here.
# Keep the release artifact bucket separate. Production signing secret must differ from JWT (>=32 bytes).
STORAGE_TYPE=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-northeast-2
STORAGE_S3_PREFIX=pastport
STORAGE_SIGNING_SECRET=
CHAT_API_ENABLED=false
LISTING_HISTORY_ENABLED=false
TRADE_PURCHASE_REQUESTS_ENABLED=false
TRADE_P3_ENABLED=false
TRADE_P4_ENABLED=false
PRODUCT_SERIAL_SECRET=

# Email verification via Supabase Auth. Keep real values in .env only.
SUPABASE_URL=
SUPABASE_SECRET=

# 이미 적용된 최신 버전보다 낮은 번호의 마이그레이션이 뒤늦게 병합됐을 때만 true로 둔다.
# FLYWAY_OUT_OF_ORDER=false
